<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import com.auction.client.ui.UserMenu?>
<?import com.auction.client.ui.AppFooter?>
<?import javafx.scene.control.ScrollPane?>

<BorderPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.AuctionRoomController"
            prefHeight="720.0" prefWidth="1200.0">

    <!-- Thanh điều hướng trên cùng -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar">
            <Button text="Quay lại" onAction="#handleBackToHome"/>
            <VBox spacing="2.0">
                <Label fx:id="lblBrandName" styleClass="view-title t-h3"/>
                <Label text="Phiên đấu giá trực tiếp đang diễn ra" styleClass="view-subtitle t-caption"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>

            <UserMenu/>
        </HBox>
    </top>

    <!-- Khu vực nội dung chính -->
    <center>
        <ScrollPane fx:id="detailScroll" fitToWidth="true" fitToHeight="false"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="main-scroll">
            <content>
                <StackPane alignment="TOP_CENTER">
                <VBox fx:id="pageContent" spacing="0.0" maxWidth="1200.0" styleClass="dashboard-content">
                    <padding><Insets top="0.0" right="32.0" bottom="32.0" left="32.0"/></padding>
                    <HBox fx:id="devModeBox" alignment="CENTER_RIGHT" spacing="10.0" visible="false"
                          managed="false" style="-fx-padding: 12px 0 0 0;">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="CHẾ ĐỘ DEV — DỮ LIỆU GIẢ" styleClass="badge-dev"/>
                        <Button text="Mô phỏng lượt đặt giá" onAction="#handleSimulateIncomingBid"/>
                    </HBox>
                    <VBox styleClass="page-intro" style="-fx-padding: 24px 0 0 0;">
                        <Label text="Phòng đấu giá" styleClass="page-title t-display"/>
                        <Label text="Theo dõi diễn biến và đặt giá theo thời gian thực." styleClass="page-subtitle t-body"/>
                    </VBox>
                    <HBox spacing="20.0" style="-fx-padding: 20px 0 0 0;">

            <!-- ===== CỘT TRÁI (500px) ===== -->
            <VBox spacing="16.0" prefWidth="500.0" minWidth="500.0" maxWidth="500.0">

                <!-- Card: Thông tin sản phẩm -->
                <VBox spacing="10.0" styleClass="card-panel">
                    <!-- Header: category tag + status badge -->
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label fx:id="lblCategory" text="Danh mục" styleClass="category-tag"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblStatus" text="Đang diễn ra" styleClass="badge-status, badge-running"/>
                    </HBox>

                    <!-- Placeholder ảnh sản phẩm -->
                    <StackPane styleClass="product-image-placeholder" prefHeight="200.0">
                        <Label fx:id="lblProductImageIcon" text="Hình ảnh sản phẩm"
                               styleClass="product-image-icon"/>
                    </StackPane>

                    <!-- Tên sản phẩm -->
                    <Label fx:id="lblItemName" text="Tên sản phẩm" styleClass="product-title t-h3"
                           wrapText="true" maxHeight="46.0"/>
                    <!-- Người bán -->
                    <Label fx:id="lblSeller" text="Người bán: seller" styleClass="text-secondary"/>
                    <!-- Mô tả -->
                    <Label fx:id="lblDescription" text="Mô tả chi tiết sản phẩm..." wrapText="true"
                           styleClass="product-description"/>

                </VBox>

                <!-- Card: Đặt giá -->
                <VBox spacing="12.0" styleClass="card-panel, hero-bid-panel">

                    <!-- Giá hiện tại + countdown -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label text="Giá hiện tại" styleClass="hero-label t-body"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblCountdown" text="--:--:--" styleClass="countdown-label"/>
                    </HBox>

                    <!-- Hiển thị giá lớn -->
                    <Label fx:id="lblCurrentPrice" text="0 ₫" styleClass="price-hero t-price"/>

                    <!-- Người dẫn đầu -->
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <Label text="Người dẫn đầu:" styleClass="text-secondary"/>
                        <Label fx:id="lblHighestBidder" text="Chưa có" styleClass="text-bold"/>
                    </HBox>

                    <!-- Thời gian kết thúc + giá bắt đầu -->
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <Label text="Thời gian kết thúc:" styleClass="text-secondary"/>
                        <Label fx:id="lblEndTime" text="--:--" styleClass="text-bold"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Bắt đầu:" styleClass="text-secondary"/>
                        <Label fx:id="lblStartingPrice" text="0 ₫" styleClass="text-bold"/>
                    </HBox>

                    <!-- Mức tối thiểu -->
                    <HBox alignment="CENTER_LEFT" spacing="4.0">
                        <Label text="Mức đặt tối thiểu:" styleClass="text-secondary t-small"/>
                        <Label fx:id="lblMinNextBid" text="0 ₫" styleClass="min-bid-hint t-body"/>
                    </HBox>

                    <!-- Giải thích trạng thái -->
                    <Label fx:id="lblStatusExplanation" text="Phiên đấu giá đang diễn ra." wrapText="true"
                           styleClass="status-explanation"/>

                    <!-- Form đặt giá -->
                    <VBox spacing="8.0">
                        <Label text="Số tiền đặt giá (₫)" styleClass="form-label"/>
                        <VBox spacing="8.0">
                            <TextField fx:id="txtBidAmount" promptText="Nhập mức giá"
                                       styleClass="bid-input" maxWidth="Infinity"/>
                            <Button fx:id="btnPlaceBid" text="Đặt giá" onAction="#handlePlaceBid"
                                    styleClass="btn-primary" maxWidth="Infinity"/>
                        </VBox>
                        <HBox fx:id="alertBox" alignment="CENTER_LEFT" spacing="8.0"
                              styleClass="alert-box, alert-error" visible="false" managed="false">
                            <Label fx:id="lblAlertMessage" text="Thông báo lỗi" wrapText="true"/>
                        </HBox>
                    </VBox>

                    <!-- Quick bid buttons -->
                    <VBox spacing="6.0">
                        <Label text="Tăng nhanh" styleClass="text-secondary"/>
                        <HBox spacing="6.0">
                            <Button fx:id="btnQuickAdd1" text="+ 1.000.000 ₫"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button fx:id="btnQuickAdd2" text="+ 5.000.000 ₫"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button fx:id="btnQuickAdd3" text="+ 10.000.000 ₫"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>

            <!-- ===== CỘT PHẢI (grow) ===== -->
            <VBox spacing="16.0" HBox.hgrow="ALWAYS">

                <!-- Card: Biểu đồ giá -->
                <VBox spacing="8.0" styleClass="card-panel">
                    <HBox alignment="CENTER_LEFT">
                    <Label text="Biến động giá" styleClass="section-header t-h2"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    <HBox alignment="CENTER" spacing="6.0" styleClass="live-pill">
                        <Region styleClass="live-indicator"/>
                        <Label text="Trực tiếp" styleClass="t-caption"/>
                    </HBox>
                </HBox>
                <Label text="Giá cao nhất theo thời gian (triệu đồng)"
                       styleClass="chart-subtitle t-small"/>
                <StackPane fx:id="chartContainer" styleClass="chart-container"
                           prefHeight="320.0" minHeight="240.0" maxHeight="320.0">
                    <AreaChart fx:id="priceChart" prefHeight="304.0" minHeight="224.0"
                               maxHeight="304.0" title="" legendVisible="false"
                               animated="false" createSymbols="true">
                        <xAxis>
                            <NumberAxis fx:id="xAxisTime" label="" animated="false"
                                        autoRanging="false" forceZeroInRange="false"
                                        tickMarkVisible="false"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="yAxisPrice" label="" animated="false"
                                        autoRanging="false" forceZeroInRange="false"
                                        minorTickVisible="false" tickMarkVisible="false"/>
                        </yAxis>
                    </AreaChart>
                    <Label fx:id="lblNoBids" text="Chưa có lượt đặt giá"
                           styleClass="chart-empty t-small" mouseTransparent="true"
                           visible="false" managed="false"/>
                </StackPane>
                </VBox>

                <!-- Card: Lịch sử đặt giá -->
                <VBox spacing="8.0" styleClass="card-panel" prefHeight="300.0" maxHeight="300.0">
                    <Label text="Lịch sử đặt giá" styleClass="section-header"/>
                    <ListView fx:id="lvRecentBids" VBox.vgrow="ALWAYS" styleClass="plain-list-view"/>
                </VBox>
            </VBox>
                    </HBox>
                    <Region VBox.vgrow="ALWAYS"/>
                    <AppFooter/>
                </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
