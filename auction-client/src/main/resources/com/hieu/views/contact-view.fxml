<?xml version="1.0" encoding="UTF-8"?>
<?import com.hieu.ui.UserMenu?>
<?import com.hieu.util.ThemeToggle?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hieu.controllers.ContactController" prefWidth="1200.0" prefHeight="780.0">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="top-bar">
            <Button fx:id="btnBack" text="← Quay lại" onAction="#handleBack" styleClass="btn-secondary"/>
            <Label text="Liên hệ" styleClass="view-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <UserMenu fx:id="userMenu"/>
            <ThemeToggle/>
            <Button fx:id="btnLogin" text="Đăng nhập" onAction="#handleLogin" styleClass="btn-primary, btn-pill"
                    visible="false" managed="false"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="contactScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="main-scroll">
            <content>
                <VBox fx:id="pageContent" spacing="20.0" styleClass="page-content">
                    <padding><Insets top="28.0" right="28.0" bottom="0.0" left="28.0"/></padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
