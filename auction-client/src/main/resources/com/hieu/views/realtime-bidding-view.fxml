<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import com.hieu.util.ThemeToggle?>

<BorderPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hieu.controllers.RealtimeBiddingController"
            prefHeight="720.0" prefWidth="1200.0">

    <!-- Thanh điều hướng trên cùng -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar">
            <Button text="← Quay lại" onAction="#handleBackToDashboard" styleClass="btn-secondary"/>
            <VBox spacing="2.0">
                <Label text="VaultAuction" styleClass="view-title"/>
                <Label text="Phiên đấu giá trực tiếp đang diễn ra" styleClass="view-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Badge trạng thái -->
            <Label fx:id="lblStatus" text="Đang diễn ra" styleClass="badge-status, badge-running"/>

            <!-- Khối chế độ nhà phát triển -->
            <HBox fx:id="devModeBox" alignment="CENTER_RIGHT" spacing="10.0" visible="false" managed="false">
                <Label text="CHẾ ĐỘ DEV — DỮ LIỆU GIẢ" styleClass="badge-dev"/>
                <Button text="Mô phỏng lượt đặt giá" onAction="#handleSimulateIncomingBid" styleClass="btn-outline"/>
            </HBox>

            <!-- Theme toggle -->
            <ThemeToggle/>
        </HBox>
    </top>

    <!-- Khu vực nội dung chính -->
    <center>
        <HBox spacing="20.0" style="-fx-padding: 20px;">

            <!-- ===== CỘT TRÁI (500px) ===== -->
            <VBox spacing="16.0" prefWidth="500.0" minWidth="500.0" maxWidth="500.0">

                <!-- Card: Thông tin sản phẩm -->
                <VBox spacing="10.0" styleClass="card-panel">
                    <!-- Header: category tag + status badge -->
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label fx:id="lblCategory" text="Danh mục" styleClass="category-tag"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <!-- Placeholder ảnh sản phẩm -->
                    <StackPane styleClass="product-image-placeholder">
                        <Rectangle width="456.0" height="200.0" arcWidth="10" arcHeight="10"
                                   styleClass="product-image-placeholder"/>
                        <Label text="🖼 Hình ảnh sản phẩm" styleClass="text-secondary"/>
                    </StackPane>

                    <!-- Tên sản phẩm -->
                    <Label fx:id="lblItemName" text="Tên sản phẩm" styleClass="product-title" wrapText="true"/>
                    <!-- Người bán -->
                    <Label fx:id="lblSeller" text="Người bán: seller" styleClass="text-secondary"/>
                    <!-- Mô tả -->
                    <Label fx:id="lblDescription" text="Mô tả chi tiết sản phẩm..." wrapText="true"
                           styleClass="product-description"/>

                    <Separator styleClass="thin-divider"/>
                </VBox>

                <!-- Card: Đặt giá -->
                <VBox spacing="12.0" styleClass="card-panel, hero-bid-panel" VBox.vgrow="ALWAYS">

                    <!-- Giá hiện tại + countdown -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label text="Giá hiện tại" styleClass="hero-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblCountdown" text="--:--:--" styleClass="countdown-label"/>
                    </HBox>

                    <!-- Hiển thị giá lớn -->
                    <Label fx:id="lblCurrentPrice" text="0 ₫" styleClass="price-hero"/>

                    <!-- Người dẫn đầu -->
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <Label text="Người dẫn đầu:" styleClass="text-secondary"/>
                        <Label fx:id="lblHighestBidder" text="Chưa có" styleClass="text-bold"/>
                    </HBox>

                    <!-- Thời gian kết thúc + giá bắt đầu -->
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <Label text="Thời gian kết thúc:" styleClass="text-secondary"/>
                        <Label fx:id="lblEndTime" text="--:--" styleClass="text-bold"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Bắt đầu:" styleClass="text-secondary"/>
                        <Label fx:id="lblStartingPrice" text="0 ₫" styleClass="text-bold"/>
                    </HBox>

                    <!-- Mức tối thiểu -->
                    <Label fx:id="lblMinNextBid" text="Mức đặt tối thiểu: 0 ₫" styleClass="min-bid-hint"/>

                    <!-- Giải thích trạng thái -->
                    <Label fx:id="lblStatusExplanation" text="Phiên đấu giá đang diễn ra." wrapText="true"
                           styleClass="status-explanation"/>

                    <!-- Form đặt giá -->
                    <VBox spacing="6.0">
                        <Label text="Số tiền đặt giá (₫)" styleClass="form-label"/>
                        <HBox spacing="8.0">
                            <TextField fx:id="txtBidAmount" promptText="Nhập mức giá"
                                       styleClass="bid-input" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnPlaceBid" text="Đặt giá 🔨" onAction="#handlePlaceBid"
                                    styleClass="btn-primary, pill" prefHeight="40.0"/>
                        </HBox>
                        <HBox fx:id="alertBox" alignment="CENTER_LEFT" spacing="8.0"
                              styleClass="alert-box, alert-error" visible="false" managed="false">
                            <Label fx:id="lblAlertMessage" text="Thông báo lỗi" wrapText="true"/>
                        </HBox>
                    </VBox>

                    <!-- Quick bid buttons -->
                    <VBox spacing="6.0">
                        <Label text="Tăng nhanh" styleClass="text-secondary"/>
                        <HBox spacing="6.0">
                            <Button fx:id="btnQuickAdd1" text="+ 1.000.000 ₫" styleClass="btn-secondary"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button fx:id="btnQuickAdd2" text="+ 5.000.000 ₫" styleClass="btn-secondary"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button fx:id="btnQuickAdd3" text="+ 10.000.000 ₫" styleClass="btn-secondary"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>

            <!-- ===== CỘT PHẢI (grow) ===== -->
            <VBox spacing="16.0" HBox.hgrow="ALWAYS">

                <!-- Card: Biểu đồ giá -->
                <VBox spacing="8.0" styleClass="card-panel" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Biến động giá" styleClass="section-header"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="● TRỰC TIẾP" styleClass="live-pill"/>
                    </HBox>

                    <LineChart fx:id="priceChart" VBox.vgrow="ALWAYS">
                        <xAxis>
                            <CategoryAxis fx:id="xAxisTime" label="Thời gian"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="yAxisPrice" autoRanging="true" forceZeroInRange="false"
                                        label="Mức giá (₫)"/>
                        </yAxis>
                    </LineChart>
                </VBox>

                <!-- Card: Lịch sử đặt giá -->
                <VBox spacing="8.0" styleClass="card-panel" prefHeight="250.0">
                    <Label text="Lịch sử đặt giá" styleClass="section-header"/>
                    <ListView fx:id="lvRecentBids" VBox.vgrow="ALWAYS" styleClass="plain-list-view"/>
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
