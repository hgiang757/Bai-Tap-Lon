<?xml version="1.0" encoding="UTF-8"?>
<?import com.hieu.ui.AppFooter?>
<?import com.hieu.ui.UserMenu?>
<?import com.hieu.util.ThemeToggle?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hieu.controllers.ProductManagementController"
            prefHeight="720.0" prefWidth="1200.0">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar">
            <Button text="Về Dashboard" onAction="#handleBackToDashboard" styleClass="btn-secondary"/>
            <VBox spacing="2.0">
                <Label text="Quản lý bán hàng" styleClass="view-title"/>
                <Label text="Quản lý sản phẩm và phiên đấu giá của bạn" styleClass="view-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <UserMenu/>
            <ThemeToggle/>
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="productScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="main-scroll">
            <content>
                <VBox spacing="0.0" styleClass="dashboard-content">
                    <HBox spacing="20.0" prefHeight="640.0" minHeight="620.0">
                        <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/></padding>
                        <VBox spacing="12.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Label text="Sản phẩm của tôi" styleClass="section-header"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="txtSearch" promptText="Tìm tên hoặc danh mục..." prefWidth="240.0"/>
                            </HBox>
                            <TableView fx:id="tblProducts" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colName" text="Tên sản phẩm" prefWidth="210.0"/>
                                    <TableColumn fx:id="colCategory" text="Loại" prefWidth="145.0"/>
                                    <TableColumn fx:id="colPrice" text="Giá khởi điểm" prefWidth="140.0"/>
                                    <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="125.0"/>
                                    <TableColumn fx:id="colAction" text="Thao tác" prefWidth="150.0"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                        </VBox>
                        <VBox spacing="12.0" styleClass="card-panel" prefWidth="370.0" minWidth="340.0">
                            <Label fx:id="lblFormTitle" text="Thêm sản phẩm mới" styleClass="section-header"/>
                            <HBox fx:id="alertBox" alignment="CENTER_LEFT" spacing="8.0"
                                  styleClass="alert-box, alert-error" visible="false" managed="false">
                                <Label fx:id="lblAlertMessage" text="Thông báo" wrapText="true"/>
                            </HBox>
                            <VBox spacing="5.0">
                                <Label text="Tên sản phẩm" styleClass="form-label"/>
                                <TextField fx:id="txtName" promptText="Nhập tên sản phẩm"/>
                            </VBox>
                            <VBox spacing="5.0">
                                <Label text="Danh mục" styleClass="form-label"/>
                                <ComboBox fx:id="cbCategory" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="5.0">
                                <Label text="Mô tả" styleClass="form-label"/>
                                <TextArea fx:id="txtDescription" promptText="Tình trạng, xuất xứ, thông tin sản phẩm..."
                                          prefRowCount="3" wrapText="true"/>
                            </VBox>
                            <VBox spacing="5.0">
                                <Label text="Giá khởi điểm (đ)" styleClass="form-label"/>
                                <TextField fx:id="txtStartingPrice" promptText="Ví dụ: 10000000"/>
                            </VBox>
                            <HBox spacing="10.0">
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label text="Thời lượng (phút)" styleClass="form-label"/>
                                    <TextField fx:id="txtDuration" text="60"/>
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label text="Bước giá (đ)" styleClass="form-label"/>
                                    <TextField fx:id="txtMinStep" text="500000"/>
                                </VBox>
                            </HBox>
                            <Label text="Ảnh sản phẩm" styleClass="form-label"/>
                            <Button fx:id="btnChooseImage" text="Chọn ảnh (không bắt buộc)"
                                    onAction="#handleChooseImage" styleClass="btn-outline" maxWidth="Infinity"/>
                            <Label fx:id="lblImageName" text="Chưa chọn ảnh" styleClass="text-secondary" wrapText="true"/>
                            <Region VBox.vgrow="ALWAYS"/>
                            <HBox spacing="8.0">
                                <Button fx:id="btnClear" text="Hủy" onAction="#handleClear"
                                        styleClass="btn-outline" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button fx:id="btnAdd" text="Tạo mới" onAction="#handleAdd"
                                        styleClass="btn-primary, btn-pill" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button fx:id="btnUpdate" text="Lưu sửa" onAction="#handleUpdate" disable="true"
                                        styleClass="btn-primary, btn-pill" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </HBox>
                        </VBox>
                    </HBox>
                    <AppFooter/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
