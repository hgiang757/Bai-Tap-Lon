<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hieu.controllers.ProductManagementController"
            prefHeight="720.0" prefWidth="1080.0">

    <!-- Thanh tiêu đề trên cùng -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar">
            <Button text="Quay lại danh sách" onAction="#handleBackToDashboard" styleClass="btn-secondary"/>
            <VBox spacing="2.0">
                <Label text="Quản lý sản phẩm đấu giá" styleClass="view-title"/>
                <Label text="Khu vực dành cho người bán thiết lập danh mục và mở phiên đấu giá" styleClass="view-subtitle"/>
            </VBox>
        </HBox>
    </top>

    <!-- Nội dung chính: Form bên trái & Bảng bên phải -->
    <center>
        <HBox spacing="20.0" style="-fx-padding: 20px;">
            <!-- Form thông tin sản phẩm -->
            <VBox spacing="12.0" styleClass="card-panel" prefWidth="420.0">
                <Label text="Thông tin sản phẩm" styleClass="section-header"/>

                <!-- Khung thông báo lỗi / thành công -->
                <HBox fx:id="alertBox" alignment="CENTER_LEFT" spacing="8.0" styleClass="alert-box, alert-error" visible="false" managed="false">
                    <Label fx:id="lblAlertMessage" text="Thông báo" wrapText="true"/>
                </HBox>

                <VBox spacing="4.0">
                    <Label text="Tên sản phẩm (*)" styleClass="form-label"/>
                    <TextField fx:id="txtName" promptText="Nhập tên sản phẩm"/>
                </VBox>

                <VBox spacing="4.0">
                    <Label text="Danh mục" styleClass="form-label"/>
                    <ComboBox fx:id="cbCategory" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="4.0">
                    <Label text="Mô tả chi tiết" styleClass="form-label"/>
                    <TextArea fx:id="txtDescription" promptText="Mô tả tình trạng, xuất xứ hiện vật..." prefRowCount="4" wrapText="true"/>
                </VBox>

                <VBox spacing="4.0">
                    <Label text="Giá khởi điểm (₫) (*)" styleClass="form-label"/>
                    <TextField fx:id="txtStartingPrice" promptText="ví dụ: 10000000"/>
                </VBox>

                <HBox spacing="10.0">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label text="Thời lượng (phút)" styleClass="form-label"/>
                        <TextField fx:id="txtDuration" text="60" promptText="60"/>
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label text="Bước giá tối thiểu (₫)" styleClass="form-label"/>
                        <TextField fx:id="txtMinStep" text="500000" promptText="500000"/>
                    </VBox>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>

                <!-- Các nút hành động -->
                <VBox spacing="8.0">
                    <HBox spacing="10.0">
                        <Button fx:id="btnAdd" text="Thêm và mở đấu giá" onAction="#handleAdd" styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="btnUpdate" text="Cập nhật" onAction="#handleUpdate" disable="true" styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                    <HBox spacing="10.0">
                        <Button fx:id="btnDelete" text="Xóa sản phẩm" onAction="#handleDelete" disable="true" styleClass="btn-danger" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="btnClear" text="Làm mới form" onAction="#handleClear" styleClass="btn-outline" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Bảng danh sách sản phẩm của người bán -->
            <VBox spacing="10.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Danh sách sản phẩm của bạn" styleClass="section-header"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Chọn một dòng để sửa hoặc xóa" styleClass="text-secondary"/>
                </HBox>

                <TableView fx:id="tblProducts" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="Mã SP" prefWidth="80.0"/>
                        <TableColumn fx:id="colName" text="Tên sản phẩm" prefWidth="180.0"/>
                        <TableColumn fx:id="colCategory" text="Danh mục" prefWidth="140.0"/>
                        <TableColumn fx:id="colPrice" text="Giá khởi điểm" prefWidth="130.0"/>
                        <TableColumn fx:id="colDescription" text="Mô tả" prefWidth="200.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </HBox>
    </center>

</BorderPane>
