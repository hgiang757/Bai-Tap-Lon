<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hieu.controllers.DashboardController"
            prefHeight="720.0" prefWidth="1100.0">

    <!-- Thanh tiêu đề trên cùng -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar">
            <VBox spacing="2.0">
                <Label text="Sàn đấu giá trực tuyến" styleClass="view-title"/>
                <Label fx:id="lblWelcomeUser" text="Xin chào" styleClass="view-subtitle"/>
            </VBox>

            <Label fx:id="lblUserRole" text="Người đấu giá" styleClass="badge-status, badge-open"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Các thao tác chính -->
            <Button fx:id="btnProductManagement" text="Quản lý sản phẩm" onAction="#handleOpenProductManagement" styleClass="btn-secondary"/>
            <Button fx:id="btnLogout" text="Đăng xuất" onAction="#handleLogout" styleClass="btn-outline"/>
        </HBox>
    </top>

    <!-- Nội dung: Thanh lọc & Bảng danh sách -->
    <center>
        <VBox spacing="16.0" style="-fx-padding: 20px;">
            <!-- Thanh công cụ tìm kiếm và lọc -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card-panel, toolbar-panel">
                <Label text="Tìm kiếm:" styleClass="form-label"/>
                <TextField fx:id="txtSearch" promptText="Tìm theo tên sản phẩm, danh mục, người bán..." prefWidth="300.0"/>

                <Label text="Trạng thái:" styleClass="form-label"/>
                <ComboBox fx:id="cbStatusFilter" prefWidth="150.0"/>

                <Button fx:id="btnRefresh" text="Làm mới" onAction="#loadAuctions" styleClass="btn-secondary"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnEnterAuction" text="Vào phòng đấu giá" onAction="#handleEnterAuction" styleClass="btn-primary"/>
            </HBox>

            <!-- Bảng danh sách các phiên đấu giá -->
            <TableView fx:id="tblAuctions" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="Mã phiên" prefWidth="90.0"/>
                    <TableColumn fx:id="colItemName" text="Tên sản phẩm" prefWidth="250.0"/>
                    <TableColumn fx:id="colCategory" text="Danh mục" prefWidth="150.0"/>
                    <TableColumn fx:id="colStartingPrice" text="Giá khởi điểm" prefWidth="130.0"/>
                    <TableColumn fx:id="colCurrentPrice" text="Giá hiện tại" prefWidth="140.0"/>
                    <TableColumn fx:id="colHighestBidder" text="Người dẫn đầu" prefWidth="120.0"/>
                    <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="110.0"/>
                    <TableColumn fx:id="colEndTime" text="Thời gian kết thúc" prefWidth="140.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_RIGHT">
                <Label text="Gợi ý: Nhấp đúp vào bất kỳ dòng nào để mở phòng đấu giá trực tiếp." styleClass="text-secondary"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
