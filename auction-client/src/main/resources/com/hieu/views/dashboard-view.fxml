<?xml version="1.0" encoding="UTF-8"?>

<?import com.hieu.util.ThemeToggle?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hieu.controllers.DashboardController" prefHeight="780.0" prefWidth="1200.0">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="top-bar">
            <Label fx:id="lblLogoIcon" styleClass="top-logo-icon"/>
            <Label text="VaultAuction" styleClass="top-logo-text"/>
            <Region prefWidth="12.0"/>
            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="search-box"><Label fx:id="lblSearchIcon"/><TextField fx:id="txtSearch" promptText="Tìm kiếm phiên đấu giá..." styleClass="search-bar" prefWidth="260.0"/></HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <ThemeToggle/>
            <VBox alignment="CENTER_RIGHT" spacing="2.0"><Label fx:id="lblWelcomeUser" text="Xin chào" styleClass="top-username"/><Label fx:id="lblUserRole" text="Người đấu giá" styleClass="badge-status, badge-open"/></VBox>
            <Label fx:id="lblUserAvatar" text="V" styleClass="seller-avatar"/>
            <Button fx:id="btnProductManagement" text="Quản lý bán hàng" onAction="#handleOpenProductManagement" styleClass="btn-secondary" visible="false" managed="false"/>
            <Button fx:id="btnLogout" text="Đăng xuất" onAction="#handleLogout" styleClass="btn-outline"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="dashboardScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="main-scroll">
            <VBox fx:id="dashboardContent" spacing="28.0" styleClass="dashboard-content"><padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></padding>
                <HBox fx:id="categoryChipsBox" spacing="8.0" alignment="CENTER_LEFT">
                    <Button fx:id="chipAll" text="Tất cả" styleClass="category-chip, category-chip-active" onAction="#handleCategoryFilter" userData="all"/>
                    <Button fx:id="chipWatch" text="Đồng hồ và trang sức" styleClass="category-chip" onAction="#handleCategoryFilter" userData="Đồng hồ cao cấp"/>
                    <Button fx:id="chipArt" text="Tranh nghệ thuật" styleClass="category-chip" onAction="#handleCategoryFilter" userData="Nghệ thuật"/>
                    <Button fx:id="chipHome" text="Bất động sản" styleClass="category-chip" onAction="#handleCategoryFilter" userData="Bất động sản"/>
                    <Button fx:id="chipCar" text="Xe cộ" styleClass="category-chip" onAction="#handleCategoryFilter" userData="Xe cộ"/>
                    <Button fx:id="chipLaptop" text="Công nghệ" styleClass="category-chip" onAction="#handleCategoryFilter" userData="Thiết bị công nghệ"/>
                </HBox>
                <HBox spacing="20.0" alignment="TOP_LEFT">
                    <VBox fx:id="mainColumn" spacing="28.0" HBox.hgrow="ALWAYS">
                        <VBox fx:id="featuredPane" spacing="16.0" styleClass="featured-card"><padding><Insets top="20.0" right="24.0" bottom="24.0" left="24.0"/></padding>
                            <Label fx:id="lblFeaturedHeader" text="Phiên đấu giá nổi bật" styleClass="section-header"/>
                            <HBox spacing="20.0" alignment="CENTER_LEFT">
                                <StackPane styleClass="auction-card-image, featured-image" prefWidth="240.0" prefHeight="190.0"><Label fx:id="lblFeaturedImagePlaceholder"/></StackPane>
                                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                    <HBox spacing="8.0" alignment="CENTER_LEFT"><Label fx:id="lblFeaturedStatus" text="ĐANG DIỄN RA" styleClass="badge-status, badge-running"/><Label fx:id="lblFeaturedCode" text="#AUC-000" styleClass="panel-text-muted"/></HBox>
                                    <Label fx:id="lblFeaturedName" text="Đang tải..." styleClass="featured-title" wrapText="true"/>
                                    <Label fx:id="lblFeaturedCategory" text="Danh mục" styleClass="panel-text-muted"/><Label text="Tình trạng: Đã kiểm định" styleClass="panel-text-muted"/>
                                    <VBox spacing="4.0"><Label text="Giá hiện tại" styleClass="hero-label"/><Label fx:id="lblFeaturedPrice" text="0 ₫" styleClass="price-hero"/></VBox>
                                    <HBox spacing="8.0" alignment="CENTER_LEFT"><Label fx:id="lblFeaturedCountdownIcon"/><Label fx:id="lblFeaturedCountdown" text="--:--:--" styleClass="countdown-label"/></HBox>
                                    <HBox spacing="12.0" alignment="CENTER_LEFT"><Button fx:id="btnFeaturedJoin" text="Tham gia ngay" onAction="#handleJoinFeatured" styleClass="btn-primary, btn-pill"/><Label fx:id="lblFeaturedBidCount" text="0 lượt đặt giá" styleClass="panel-text-muted"/></HBox>
                                </VBox>
                            </HBox>
                        </VBox>
                        <VBox spacing="12.0"><HBox alignment="CENTER_LEFT" spacing="8.0"><Label fx:id="lblRunningHeader" text="Đang diễn ra" styleClass="section-header"/><Region HBox.hgrow="ALWAYS"/><Button text="Làm mới" onAction="#loadAuctions" styleClass="btn-secondary"/></HBox>
                            <FlowPane fx:id="auctionGrid" hgap="20.0" vgap="20.0" alignment="TOP_LEFT" prefWrapLength="720.0"/>
                            <Label fx:id="lblNoResults" text="Không có phiên đấu giá nào phù hợp." styleClass="empty-placeholder" visible="false" managed="false"/>
                        </VBox>
                        <VBox spacing="16.0"><Label fx:id="lblStepsHeader" text="Cách hoạt động" styleClass="section-header"/>
                            <HBox spacing="16.0" alignment="CENTER" fillHeight="true">
                                <VBox styleClass="step-card" alignment="CENTER" spacing="10.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"><StackPane styleClass="step-number"><Label text="1"/></StackPane><Label fx:id="lblStepOneIcon"/><Label text="Đăng ký" styleClass="step-title"/><Label text="Tạo tài khoản miễn phí và xác minh danh tính trong vài phút" styleClass="step-desc" wrapText="true"/></VBox>
                                <VBox styleClass="step-card" alignment="CENTER" spacing="10.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"><StackPane styleClass="step-number"><Label text="2"/></StackPane><Label fx:id="lblStepTwoIcon"/><Label text="Đấu giá" styleClass="step-title"/><Label text="Tìm phiên yêu thích, đặt giá và theo dõi kết quả thời gian thực" styleClass="step-desc" wrapText="true"/></VBox>
                                <VBox styleClass="step-card" alignment="CENTER" spacing="10.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"><StackPane styleClass="step-number"><Label text="3"/></StackPane><Label fx:id="lblStepThreeIcon"/><Label text="Nhận hàng" styleClass="step-title"/><Label text="Thanh toán an toàn và nhận sản phẩm tận nơi sau khi thắng đấu giá" styleClass="step-desc" wrapText="true"/></VBox>
                            </HBox>
                        </VBox>
                    </VBox>
                    <VBox styleClass="sidebar-panel" prefWidth="300.0" minWidth="280.0" maxWidth="300.0" spacing="20.0">
                        <VBox styleClass="sidebar-card" spacing="12.0"><Label fx:id="lblUpcomingHeader" text="Sắp diễn ra" styleClass="section-header"/><VBox fx:id="upcomingList" spacing="8.0"><Label text="Đang tải..." styleClass="text-secondary"/></VBox><Button text="Xem lịch đầy đủ" onAction="#handleShowFullSchedule" styleClass="btn-outline" maxWidth="Infinity"/></VBox>
                        <VBox styleClass="sidebar-card, sidebar-cta" spacing="12.0"><Label fx:id="lblSellHeader" text="Bạn có sản phẩm để bán?" styleClass="sidebar-cta-title" wrapText="true"/><Label text="Đăng ký làm người bán và bắt đầu kiếm tiền từ sàn đấu giá của chúng tôi." styleClass="text-secondary" wrapText="true"/><Button fx:id="btnListItem" text="Đăng bán ngay" onAction="#handleListItem" styleClass="btn-primary, btn-pill" maxWidth="Infinity"/></VBox>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
