<?xml version="1.0" encoding="UTF-8"?>
<?import com.auction.client.ui.AppFooter?>
<?import com.auction.client.ui.AppHeader?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.SellerProductsController"
            prefHeight="720.0" prefWidth="1200.0">
    <top>
        <AppHeader alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar">
            <Button text="Về Trang chủ" onAction="#handleBackToHome"/>
            <VBox spacing="2.0">
                <Label text="Quản lý bán hàng" styleClass="view-title t-h3"/>
                <Label text="Quản lý sản phẩm và phiên đấu giá của bạn" styleClass="view-subtitle t-caption"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            
        </AppHeader>
    </top>
    <center>
        <ScrollPane fx:id="productScroll" fitToWidth="true" fitToHeight="false"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="main-scroll">
            <content>
                <StackPane alignment="TOP_CENTER">
                <VBox fx:id="pageContent" spacing="24.0" maxWidth="1200.0" styleClass="dashboard-content">
                    <padding><Insets top="32.0" right="32.0" bottom="0.0" left="32.0"/></padding>
                    <VBox styleClass="page-intro">
                        <Label text="Quản lý sản phẩm" styleClass="page-title t-display"/>
                        <Label text="Theo dõi sản phẩm và cập nhật thông tin bán đấu giá." styleClass="page-subtitle t-body"/>
                    </VBox>
                    <HBox spacing="20.0">
                        <VBox spacing="12.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Label text="Sản phẩm của tôi" styleClass="section-header t-h2"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <StackPane fx:id="searchFieldContainer" maxWidth="480.0" HBox.hgrow="ALWAYS"
                                           styleClass="search-field-container">
                                    <TextField fx:id="txtSearch" promptText="Tìm tên hoặc danh mục..."
                                               styleClass="search-bar" maxWidth="Infinity"/>
                                    <Label fx:id="lblProductSearchIcon" mouseTransparent="true"
                                           StackPane.alignment="CENTER_LEFT">
                                        <StackPane.margin><Insets left="14.0"/></StackPane.margin>
                                    </Label>
                                </StackPane>
                            </HBox>
                            <ListView fx:id="tblProducts" prefHeight="520.0" VBox.vgrow="ALWAYS" styleClass="product-list"/>
                        </VBox>
                        <VBox spacing="12.0" styleClass="card-panel" prefWidth="370.0" minWidth="340.0">
                            <Label fx:id="lblFormTitle" text="Thêm sản phẩm mới" styleClass="section-header t-h2"/>
                            <HBox fx:id="alertBox" alignment="CENTER_LEFT" spacing="8.0"
                                  styleClass="alert-box, alert-error" visible="false" managed="false">
                                <Label fx:id="lblAlertMessage" text="Thông báo" wrapText="true"/>
                            </HBox>
                            <VBox spacing="5.0">
                                <Label text="Tên sản phẩm" styleClass="form-label"/>
                                <TextField fx:id="txtName" promptText="Nhập tên sản phẩm"/>
                            </VBox>
                            <VBox spacing="5.0">
                                <Label text="Danh mục" styleClass="form-label"/>
                                <ComboBox fx:id="cbCategory" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="5.0">
                                <Label text="Mô tả" styleClass="form-label"/>
                                <TextArea fx:id="txtDescription" promptText="Tình trạng, xuất xứ, thông tin sản phẩm..."
                                          prefRowCount="3" wrapText="true"/>
                            </VBox>
                            <VBox spacing="5.0">
                                <Label text="Giá khởi điểm (₫)" styleClass="form-label t-small"/>
                                <TextField fx:id="txtStartingPrice" promptText="Ví dụ: 10000000"/>
                            </VBox>
                            <HBox spacing="10.0">
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label text="Thời lượng (phút)" styleClass="form-label t-small"/>
                                    <TextField fx:id="txtDuration" text="60"/>
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label text="Bước giá (₫)" styleClass="form-label t-small"/>
                                    <TextField fx:id="txtMinStep" text="500000"/>
                                </VBox>
                            </HBox>
                            <Label text="Ảnh sản phẩm" styleClass="form-label"/>
                            <Button fx:id="btnChooseImage" text="Chọn ảnh (không bắt buộc)"
                                    onAction="#handleChooseImage" maxWidth="Infinity"/>
                            <Label fx:id="lblImageName" text="Chưa chọn ảnh" styleClass="text-secondary" wrapText="true"/>
                            <Region VBox.vgrow="ALWAYS"/>
                            <HBox spacing="8.0">
                                <Button fx:id="btnClear" text="Hủy" onAction="#handleClear"
                                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button fx:id="btnAdd" text="Tạo mới" onAction="#handleAdd"
                                        styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button fx:id="btnUpdate" text="Lưu sửa" onAction="#handleUpdate" disable="true"
                                        styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </HBox>
                        </VBox>
                    </HBox>
                    <Region VBox.vgrow="ALWAYS"/>
                    <AppFooter/>
                </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
