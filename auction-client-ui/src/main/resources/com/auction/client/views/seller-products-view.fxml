<?xml version="1.0" encoding="UTF-8"?>
<?import com.auction.client.ui.AppHeader?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.SellerProductsController">
    <top><AppHeader spacing="16" styleClass="top-bar"><Button text="Về trang chủ" onAction="#handleBackToHome"/><Label text="Quản lý sản phẩm" styleClass="view-title"/><Region HBox.hgrow="ALWAYS"/></AppHeader></top>
    <center><VBox spacing="16" styleClass="dashboard-content"><padding><Insets top="25" right="30" bottom="25" left="30"/></padding>
        <Label text="Sản phẩm của tôi" styleClass="page-title"/>
        <HBox spacing="10"><TextField fx:id="search" promptText="Tìm theo tên" HBox.hgrow="ALWAYS"/><ComboBox fx:id="status"/><ComboBox fx:id="category"/><Button fx:id="addButton" text="Thêm sản phẩm" styleClass="btn-primary" onAction="#add"/></HBox>
        <Label fx:id="message" styleClass="alert-error" wrapText="true"/>
        <ProgressIndicator fx:id="progress" maxWidth="30" maxHeight="30" visible="false" managed="false"/>
        <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    </VBox></center>
</BorderPane>
