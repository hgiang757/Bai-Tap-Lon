<?xml version="1.0" encoding="UTF-8"?>
<?import com.auction.client.ui.AppHeader?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.HomeController" prefHeight="780.0" prefWidth="1200.0">
    <top>
        <AppHeader alignment="CENTER_LEFT" spacing="12.0" styleClass="top-bar">
            <Label fx:id="lblLogoIcon" styleClass="top-logo-icon"/>
            <Label fx:id="lblBrandName" styleClass="top-logo-text"/>
            <Region prefWidth="12.0"/>
            <StackPane maxWidth="480.0" HBox.hgrow="ALWAYS" styleClass="search-field-container">
                <TextField fx:id="txtSearch" promptText="Tìm kiếm phiên đấu giá..." styleClass="search-bar" maxWidth="Infinity"/>
                <Label fx:id="lblSearchIcon" mouseTransparent="true" StackPane.alignment="CENTER_LEFT">
                    <StackPane.margin>
                        <Insets left="14.0"/>
                    </StackPane.margin>
                </Label>
            </StackPane>
            <Region HBox.hgrow="ALWAYS"/>
        </AppHeader>
    </top>
    <center>
        <ScrollPane fx:id="dashboardScroll" fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="main-scroll">
            <StackPane alignment="TOP_CENTER">
                <VBox fx:id="pageContent" spacing="20.0" maxWidth="1200.0" styleClass="dashboard-content">
                    <padding>
                        <Insets top="32.0" right="32.0" bottom="0.0" left="32.0"/>
                    </padding>
                    <FlowPane fx:id="categoryChipsBox" hgap="8.0" vgap="8.0" alignment="CENTER_LEFT">
                        <Button fx:id="chipAll" text="Tất cả" styleClass="btn-primary" onAction="#handleCategoryFilter" userData="all"/>
                        <Button fx:id="chipWatch" text="Đồng hồ và trang sức" onAction="#handleCategoryFilter" userData="JEWELRY"/>
                        <Button fx:id="chipArt" text="Tranh nghệ thuật" onAction="#handleCategoryFilter" userData="ART"/>
                        <Button fx:id="chipHome" text="Bất động sản" onAction="#handleCategoryFilter" userData="REAL_ESTATE"/>
                        <Button fx:id="chipCar" text="Xe cộ" onAction="#handleCategoryFilter" userData="VEHICLE"/>
                        <Button fx:id="chipLaptop" text="Công nghệ" onAction="#handleCategoryFilter" userData="ELECTRONICS"/>
                        <Button fx:id="chipOther" text="Khác" onAction="#handleCategoryFilter" userData="OTHER"/>
                    </FlowPane>
                    <VBox spacing="20.0">
                        <VBox spacing="16.0" styleClass="home-panel, home-panel-alt">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label fx:id="lblRunningHeader" text="Đang diễn ra" wrapText="true" minWidth="0" minHeight="-Infinity" styleClass="section-header, t-h2"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button minWidth="-Infinity" text="Làm mới" onAction="#loadAuctions"/>
                            </HBox>
                            <FlowPane fx:id="auctionGrid" hgap="20.0" vgap="20.0" alignment="TOP_LEFT" prefWrapLength="720.0"/>
                            <Label fx:id="lblNoResults" wrapText="true" minHeight="-Infinity" text="Không có phiên đấu giá nào phù hợp." styleClass="empty-placeholder" visible="false" managed="false"/>
                        </VBox>
                        <VBox spacing="16.0" styleClass="home-panel, home-panel-white">
                            <Label text="Sắp diễn ra" wrapText="true" minWidth="0" minHeight="-Infinity" styleClass="section-header, t-h2"/>
                            <FlowPane fx:id="upcomingGrid" hgap="20.0" vgap="20.0" alignment="TOP_LEFT" prefWrapLength="720.0"/>
                            <Label fx:id="lblUpcomingEmpty" wrapText="true" minHeight="-Infinity" styleClass="empty-placeholder" visible="false" managed="false"/>
                        </VBox>
                        <VBox spacing="16.0" styleClass="home-panel, home-panel-white">
                            <Label text="Kết quả các phiên" styleClass="section-header, t-h2"/>
                            <FlowPane fx:id="finishedGrid" hgap="20.0" vgap="20.0" alignment="TOP_LEFT"/>
                            <Label fx:id="lblFinishedEmpty" wrapText="true" styleClass="empty-placeholder"/>
                        </VBox>
                    </VBox>
                </VBox>
            </StackPane>
        </ScrollPane>
    </center>
</BorderPane>
