<?xml version="1.0" encoding="UTF-8"?>
<?import com.auction.client.ui.AppHeader?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AdminController">
    <top>
        <VBox>
        <AppHeader spacing="16" styleClass="top-bar">
            <Label text="Digital Auction — Quản trị" styleClass="view-title"/>
            <Region HBox.hgrow="ALWAYS"/>
        </AppHeader>
            <FlowPane hgap="12" vgap="10" styleClass="admin-navigation, form-controls">
                <Button text="Quản lý người dùng" onAction="#users"/>
                <Button text="Quản lý phiên đấu giá" onAction="#auctions"/>
                <Button text="Đăng xuất" onAction="#logout"/>
            </FlowPane>
        </VBox>
    </top>
    <center>
        <VBox spacing="14" styleClass="dashboard-content">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>
            <Label fx:id="title" styleClass="page-title" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="message" styleClass="alert-error" wrapText="true"/>
            <ProgressIndicator fx:id="progress" maxWidth="30" maxHeight="30" visible="false" managed="false"/>
            <VBox fx:id="content" spacing="12" VBox.vgrow="ALWAYS">
                <VBox fx:id="usersPane" spacing="12" visible="false" managed="false" VBox.vgrow="ALWAYS">
                    <FlowPane hgap="10" vgap="10" styleClass="form-controls">
                        <TextField fx:id="userSearch" promptText="Tìm tên đăng nhập hoặc email" prefWidth="320" HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="userRole"/>
                    </FlowPane>
                    <TableView fx:id="userTable" fixedCellSize="44" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Chưa có dữ liệu"/>
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="userName" text="Tên đăng nhập" prefWidth="145"/>
                            <TableColumn fx:id="userEmail" text="Email" prefWidth="145"/>
                            <TableColumn fx:id="userRoleColumn" text="Vai trò" prefWidth="145"/>
                            <TableColumn fx:id="userState" text="Trạng thái" prefWidth="145"/>
                            <TableColumn fx:id="userCreated" text="Ngày tạo" prefWidth="145"/>
                            <TableColumn fx:id="userAction" text="Thao tác" prefWidth="300" minWidth="280"/>
                        </columns>
                    </TableView>
                </VBox>
                <VBox fx:id="auctionsPane" spacing="12" visible="false" managed="false" VBox.vgrow="ALWAYS">
                    <FlowPane hgap="10" vgap="10" styleClass="form-controls">
                        <TextField fx:id="auctionSearch" promptText="Tìm tên phiên"/>
                        <ComboBox fx:id="auctionStatus"/>
                    </FlowPane>
                    <TableView fx:id="auctionTable" fixedCellSize="44" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Chưa có dữ liệu"/>
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="auctionName" text="Tên" prefWidth="240" minWidth="200"/>
                            <TableColumn fx:id="auctionPrice" text="Giá hiện tại" prefWidth="180" minWidth="160"/>
                            <TableColumn fx:id="auctionState" text="Trạng thái" prefWidth="150" minWidth="130"/>
                            <TableColumn fx:id="auctionAction" text="Thao tác" prefWidth="240" minWidth="230"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
